#!/usr/bin/env bash
# Play the game from this checkout in gasm's native runner: builds what changed (build-gasm/openbv.wasm),
# then opens the window. Anything after the options goes to gasm-run:
#
#   ./play                          vanilla 2.11 data (the GPL repository's Content/, fetched into ref/)
#   ./play --prozac                 the Prozac 2.1.3 data instead (./game, the unzipped archive)
#   ./play --data=<dir>             any folder laid out like the game's (bv2.db, main/...)
#   ./play --master=host:port       the master server (the online game list); none by default
#   ./play --fresh                  start with no saves (bv2.cfg, bv2.db changes): a throwaway folder
#   ./play --profile=ana            a second player on this machine, with saves of its own
#   ./play --debug                  the output also in build/logs/play-<time>.log
#   ./play --headless 600 --screenshot /tmp/bv.png      (anything else goes to gasm-run)
#   ./play --help                   this
#
# Environment: WINDOW=1920x1080 (default 1600x900; drag to resize), GASM_DIR=../gasm (the gasm checkout
# whose runner and SDK are used; without a built one, the pinned release in .deps/), NET=host,host (hosts the game may reach; default 127.0.0.1 and
# localhost, for a local server), LOG=file (also write the output there).
set -euo pipefail
cd "$(dirname "$0")"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# a built gasm checkout (../gasm, or GASM_DIR) if there is one, else the pinned release (.deps/)
GASM_DIR=${GASM_DIR:-../gasm}
RUN="$GASM_DIR/runners/native/target/release/gasm-run"
TOOLCHAIN="$GASM_DIR/sdk/c/cmake/gasm-toolchain.cmake"
WASI_SDK="$GASM_DIR/tools/wasi-sdk"
if [[ ! -x "$RUN" ]]; then
  case "$(uname -s)-$(uname -m)" in
    Darwin-*) plat=macos-universal ;;
    Linux-x86_64) plat=linux-x86_64 ;;
    Linux-aarch64) plat=linux-arm64 ;;
    *) echo "play: no gasm-run at $RUN and no released runner for $(uname -sm)" >&2; exit 1 ;;
  esac
  RUN="$(tools/fetch-gasm-runner.sh "$plat")/gasm-run"
fi
if [[ ! -x "$WASI_SDK/bin/clang" || ! -f "$TOOLCHAIN" ]]; then
  tools/fetch-gasm-sdk.sh >/dev/null
  TOOLCHAIN="$PWD/.deps/gasm-c-sdk/cmake/gasm-toolchain.cmake"
  WASI_SDK="$PWD/.deps/wasi-sdk"
fi

# the vanilla data: Daivuk's GPL-3.0 repository at the commit src/ was taken from
UPSTREAM=https://github.com/Daivuk/BaboViolent2.git
UPSTREAM_COMMIT=7171c84d9b4d02bb74e846d5617fbb527bfba358
VANILLA=ref/BaboViolent2/BaboViolent2/Content

DATA=""
STORAGE=openbv
FRESH=0
pass=()
while (($#)); do
  case "$1" in
    --prozac) DATA=game; STORAGE=openbv-prozac; shift ;;
    --data=*) DATA=${1#--data=}; shift ;;
    --data) DATA=$2; shift 2 ;;
    --fresh) FRESH=1; shift ;;
    --master=*) pass+=(--param "master=${1#--master=}"); shift ;;
    --profile=*) p=${1#--profile=}; shift
      [[ "$p" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "play: --profile: letters, digits, - and _ only" >&2; exit 2; }
      STORAGE="$STORAGE-$p" ;;
    --debug) mkdir -p build/logs; LOG=${LOG:-build/logs/play-$(date +%Y%m%d-%H%M%S).log}; shift ;;
    *) pass+=("$1"); shift ;;
  esac
done

if [[ -z "$DATA" ]]; then
  DATA=$VANILLA
  if [[ ! -f "$DATA/bv2.db" ]]; then
    echo "fetching the vanilla data ($UPSTREAM at ${UPSTREAM_COMMIT:0:7}) into ref/..."
    mkdir -p ref
    git clone -q "$UPSTREAM" ref/BaboViolent2
    git -C ref/BaboViolent2 checkout -q "$UPSTREAM_COMMIT"
  fi
fi
if [[ "$DATA" == game && ! -d game/main ]]; then
  echo "play: --prozac needs ./game: unzip 'Babo Violent 2 Prozac 2.1.3.zip' there (game/main, game/bv2.db, ...)" >&2
  exit 1
fi
[[ -f "$DATA/bv2.db" && -d "$DATA/main" ]] || { echo "play: $DATA doesn't look like the game's folder (bv2.db, main/)" >&2; exit 1; }

echo "building (only what changed)..."
if [[ ! -f build-gasm/CMakeCache.txt ]]; then
  cmake -S . -B build-gasm -DOPENBV_PLATFORM=gasm -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN" -DWASI_SDK_PREFIX="$WASI_SDK" >/dev/null
fi
cmake --build build-gasm -j"$(sysctl -n hw.ncpu 2>/dev/null || nproc)" >/dev/null

storage=(--storage-id "$STORAGE")
if [[ "$FRESH" == 1 ]]; then
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/openbv-fresh.XXXXXX")
  storage=(--storage-dir "$tmp")
  echo "fresh: saves in $tmp (thrown away)"
fi

cmd=("$RUN" build-gasm/openbv.wasm --asset-dir "$DATA" ${storage[@]+"${storage[@]}"}
  --allow-net="${NET:-127.0.0.1,localhost}" --window "${WINDOW:-1600x900}" ${pass[@]+"${pass[@]}"})
echo "playing: data $DATA, saves '$STORAGE'"
if [[ -n "${LOG:-}" ]]; then
  "${cmd[@]}" 2>&1 | tee "$LOG"
  echo "the log: $LOG"
else
  exec "${cmd[@]}"
fi
